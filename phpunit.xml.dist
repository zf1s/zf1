<phpunit bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <!--
            the suites of AllTests::suiteBuffered(), which `php tests/AllTests.php` runs before AllTests::suite(),
            listed first so their files are not loaded yet by tests/AllTests.php
        -->
        <testsuite name="Zend Framework - Buffered">
            <file>./tests/Zend/OpenIdTest.php</file>
            <file>./tests/Zend/OpenId/AllTests.php</file>
            <file>./tests/Zend/Session/AllTests.php</file>
            <file>./tests/Zend/Soap/AllTests.php</file>
        </testsuite>
        <testsuite name="Zend Framework - Testsuite">
            <directory>./tests/AllTests.php</directory>
        </testsuite>
    </testsuites>

    <filter>
        <whitelist>
            <directory>./packages/*/library/Zend/</directory>
        </whitelist>
    </filter>

    <!-- uncomment to identify slow tests (default threshold: 0.5s) -->
    <!--
    <listeners>
        <listener class="SlowTestListener" file="tests/SlowTestListener.php">
            <arguments>
                <double>0.5</double>
            </arguments>
        </listener>
    </listeners>
    -->

    <php>
        <ini name="date.timezone" value="UTC"/>
    </php>
</phpunit>
